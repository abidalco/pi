# Copy to bot/.env. Leave both empty for the local demo.
# Online: the server's address, and the same PI_BOT_KEY you gave the server.
PI_URL=
PI_BOT_KEY=
# headless bot (npm run auto) only: model for each job (sonnet = faster, opus = slower and sharper); empty = your Claude Code default
PI_BOT_MODEL=
# Who this terminal is (e.g. hadi, abdallah). Several bots can wait on the same app; each job goes to whichever is waiting.
PI_BOT_ID=
# image terminal (npm run images) only: how many images Codex makes at once per job (default 2)
PI_IMAGE_PARALLEL=
